# ─── Scrap Uncle — Environment Variables ───────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# ─── Database ──────────────────────────────────────────────
# PostgreSQL connection string from Supabase / Railway / Neon / Render.
# Examples:
#   Supabase:  postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Railway:   postgresql://postgres:[password]@[host].railway.app:5432/railway
#   Neon:      postgresql://[user]:[password]@[host].neon.tech/neondb?sslmode=require
#
# Leave empty to use local SQLite (scrap.db) for offline development.
DATABASE_URL=DATABASE_URL=postgresql://postgres:1ab2cd3ef@SC@db.nutrdeksqaqiaaqbsffi.supabase.co:5432/postgres

# ─── Flask ─────────────────────────────────────────────────
# A long random secret key for session signing.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=scrappy

# ─── Admin Seed ────────────────────────────────────────────
# Used by init_db.py when creating the first admin account.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ─── Server ────────────────────────────────────────────────
PORT=5432
